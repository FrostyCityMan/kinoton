<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kinoton.sales.password.dao.PasswordChangeDao">
    <resultMap id="PasswordUserMap" type="com.kinoton.sales.user.dto.AuthUserDto">
        <id property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="name" column="name"/>
        <result property="active" column="is_active"/>
        <result property="passwordResetRequired" column="is_password_reset_required"/>
    </resultMap>

    <select id="selectPasswordUserDetails" parameterType="long" resultMap="PasswordUserMap">
        -- 비밀번호 변경 대상 사용자의 인증 정보를 조회한다.
        SELECT
            u.user_id,
            u.email,
            u.password_hash,
            u.name,
            u.is_active,
            u.is_password_reset_required
        FROM users u
        WHERE u.user_id = #{userId}
    </select>

    <update id="updatePassword" parameterType="com.kinoton.sales.password.dto.PasswordUpdateCommandDto">
        -- 사용자 비밀번호를 갱신하고 비밀번호 변경 필요 상태를 해제한다.
        UPDATE users
        SET
            password_hash = #{passwordHash},
            is_password_reset_required = FALSE,
            updated_at = NOW()
        WHERE user_id = #{userId}
    </update>
</mapper>
